# Server Configuration
PORT=5000
NODE_ENV=development

# Database Connection (Use local database for development/testing)
MONGODB_URI=mongodb://localhost:27017/restaurant_app

# Email Service (Nodemailer)
EMAIL_SERVICE=gmail
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_app_password
EMAIL_FROM=your_email@example.com

# Twilio Notification Service
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=whatsapp:+14155238886
TWILIO_SMS_NUMBER=+18446031482

# Auth0 OIDC Configuration (JWT Access Token Verification)
AUTH0_DOMAIN=your-tenant.auth0.com
AUTH0_AUDIENCE=https://ssd-restaurant-api
